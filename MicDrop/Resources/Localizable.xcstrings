    "MicDrop is free, but please leave a tip if you want to see more features!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MicDrop ist kostenlos – gib gern ein Trinkgeld, wenn du mehr Funktionen sehen möchtest!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MicDrop es gratis, pero deja una propina si quieres ver más funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MicDrop est gratuit, mais laissez un pourboire si vous voulez plus de fonctionnalités !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MicDrop è gratuito, ma lascia una mancia se vuoi vedere altre funzioni!"
